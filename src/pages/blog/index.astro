---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import GlassCard from '../../components/ui/GlassCard.astro';

/** Blog structure prepared — no posts yet (none in CV/LinkedIn). */
const posts: Array<{
  slug: string;
  title: string;
  excerpt: string;
  date: string;
  tags: string[];
}> = [];
---

<BaseLayout pageId="blog">
  <section class="section-pad pt-36 md:pt-40">
    <div class="container-site">
      <div class="reveal">
        <SectionHeading
          eyebrow="Blog"
          title="Notes & insights"
          description="Structure prête pour de futurs articles. Aucun contenu inventé — les posts seront ajoutés ici."
          as="h1"
        />
      </div>

      {
        posts.length === 0 ? (
          <GlassCard class="reveal mx-auto max-w-2xl text-center" glow>
            <p class="font-display text-2xl font-semibold text-white">Bientôt disponible</p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
              Le blog est préparé (routing, layout SEO, cards). Ajoutez des entrées dans
              <code class="mx-1 rounded bg-white/10 px-1.5 py-0.5 text-[var(--color-accent-soft)]"
                >src/pages/blog/</code
              >
              ou une collection de contenu Astro.
            </p>
          </GlassCard>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="block">
                <GlassCard class="h-full transition hover:-translate-y-1" glow>
                  <p class="text-xs text-[var(--color-accent-soft)]">{post.date}</p>
                  <h2 class="mt-2 font-display text-xl font-semibold text-white">{post.title}</h2>
                  <p class="mt-3 text-sm text-[var(--color-muted)]">{post.excerpt}</p>
                </GlassCard>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
