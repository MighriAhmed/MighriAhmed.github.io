---
import { stats } from '../../content/site';
import GlassCard from '../ui/GlassCard.astro';
import { translate, type TranslationKey } from '../../i18n/translations';

function statKey(id: string, part: 'label' | 'unit' | 'description'): TranslationKey {
  return `stats.${id}.${part}` as TranslationKey;
}
---

<section
  class="container-site relative z-10 mt-0 sm:-mt-4 md:-mt-8"
  aria-label={translate('fr', 'stats.aria')}
  data-i18n-aria="stats.aria"
>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-stagger>
    {
      stats.map((stat) => (
        <GlassCard class="reveal" glow data-stagger-item>
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm text-[var(--color-muted)]" data-i18n={statKey(stat.id, 'label')}>
                {translate('fr', statKey(stat.id, 'label'))}
              </p>
              <p class="mt-3 font-display text-3xl font-bold text-white md:text-4xl">
                <span data-counter={stat.value}>0</span>
                {stat.suffix}
                {stat.unit && (
                  <span
                    class="ml-1 text-lg font-medium text-[var(--color-accent-soft)]"
                    data-i18n={statKey(stat.id, 'unit')}
                  >
                    {translate('fr', statKey(stat.id, 'unit'))}
                  </span>
                )}
              </p>
              <p
                class="mt-2 text-xs text-[var(--color-muted-2)]"
                data-i18n={statKey(stat.id, 'description')}
              >
                {translate('fr', statKey(stat.id, 'description'))}
              </p>
            </div>
            <div
              class="rounded-xl border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/10 p-2.5 text-[var(--color-accent-soft)]"
              aria-hidden="true"
            >
              {stat.id === 'experience' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  <rect width="20" height="14" x="2" y="6" rx="2" />
                </svg>
              )}
              {stat.id === 'projects' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                  <path d="M8 10h8" />
                  <path d="M8 14h4" />
                </svg>
              )}
              {stat.id === 'education' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                  <path d="M6 12v5c3 3 9 3 12 0v-5" />
                </svg>
              )}
              {stat.id === 'stack' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
                  <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
                  <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
                </svg>
              )}
            </div>
          </div>
        </GlassCard>
      ))
    }
  </div>
</section>
