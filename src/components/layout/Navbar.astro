---
import { navLinks, siteConfig } from '../../content/site';
import { translate } from '../../i18n/translations';
import { Download } from 'lucide-react';
import LanguageSwitcher from '../react/LanguageSwitcher';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <div class="container-site">
    <nav
      class="mt-4 flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-[#050816]/70 px-4 py-3 backdrop-blur-xl md:gap-4 md:px-6"
      aria-label={translate('fr', 'nav.main')}
      data-i18n-aria="nav.main"
    >
      <a href="/" class="font-display text-xl font-bold tracking-tight text-white">
        {siteConfig.shortName}<span class="text-[var(--color-accent)]">.</span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-full px-3 py-2 text-sm text-[var(--color-muted)] transition-colors hover:text-white"
                data-nav-link
                data-i18n={link.labelKey}
              >
                {translate('fr', link.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2 sm:gap-3">
        <LanguageSwitcher client:load />

        <a
          href={siteConfig.cvPath}
          download
          class="btn-primary hidden sm:inline-flex !px-4 !py-2.5"
          data-magnetic
        >
          <Download className="h-4 w-4" client:load />
          <span data-i18n="nav.downloadCv">{translate('fr', 'nav.downloadCv')}</span>
        </a>

        <button
          type="button"
          id="menu-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-white lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={translate('fr', 'nav.openMenu')}
          data-i18n-aria="nav.openMenu"
        >
          <span class="sr-only" data-i18n="nav.openMenu">{translate('fr', 'nav.openMenu')}</span>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16M4 12h16M4 17h16" id="menu-icon-open"></path>
          </svg>
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="mt-2 hidden rounded-2xl border border-white/10 bg-[#0a1024]/95 p-4 backdrop-blur-xl lg:hidden"
    >
      <ul class="flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-xl px-4 py-3 text-sm text-[var(--color-muted)] transition hover:bg-white/5 hover:text-white"
                data-mobile-link
                data-i18n={link.labelKey}
              >
                {translate('fr', link.labelKey)}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a href={siteConfig.cvPath} download class="btn-primary w-full">
            <span data-i18n="nav.downloadCv">{translate('fr', 'nav.downloadCv')}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add('[&_nav]:shadow-[0_10px_40px_rgba(0,0,0,0.35)]');
    } else {
      header.classList.remove('[&_nav]:shadow-[0_10px_40px_rgba(0,0,0,0.35)]');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const path = window.location.pathname.replace(/\/$/, '') || '/';
  const hash = window.location.hash;

  document.querySelectorAll('[data-nav-link]').forEach((el) => {
    const href = (el as HTMLAnchorElement).getAttribute('href') || '';
    const [linkPath, linkHash] = href.split('#');
    const normalizedPath = (linkPath || '/').replace(/\/$/, '') || '/';
    const isHome = path === '/';
    const matchesPath = normalizedPath === path;
    const matchesHash = linkHash
      ? hash === `#${linkHash}`
      : isHome && (href === '/' || href === '/#home') && !hash;

    if ((matchesPath && !linkHash) || (isHome && matchesHash) || (isHome && linkHash && hash === `#${linkHash}`)) {
      el.classList.add('text-white', 'bg-white/5');
      el.classList.remove('text-[var(--color-muted)]');
    }
  });
</script>
