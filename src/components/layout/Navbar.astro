---
import { navLinks, siteConfig } from '../../content/site';
import { translate } from '../../i18n/translations';
import { Download } from 'lucide-react';
import LanguageSwitcher from '../react/LanguageSwitcher';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 pt-[env(safe-area-inset-top)] transition-all duration-300"
>
  <div class="container-site">
    <nav
      class="mt-3 flex items-center justify-between gap-2 rounded-2xl border border-white/10 bg-[#050816]/70 px-3 py-3 backdrop-blur-xl sm:gap-3 sm:px-4 md:mt-4 md:gap-4 md:px-6"
      aria-label={translate('fr', 'nav.main')}
      data-i18n-aria="nav.main"
    >
      <a href="/" class="shrink-0 font-display text-xl font-bold tracking-tight text-white">
        {siteConfig.shortName}<span class="text-[var(--color-accent)]">.</span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-full px-3 py-2 text-sm text-[var(--color-muted)] transition-colors hover:text-white"
                data-nav-link
                data-i18n={link.labelKey}
              >
                {translate('fr', link.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <LanguageSwitcher client:load />

        <a
          href={siteConfig.cvPath}
          download={siteConfig.cvFileName}
          class="btn-primary hidden lg:inline-flex !px-4 !py-2.5"
          data-magnetic
        >
          <Download className="h-4 w-4" client:load />
          <span data-i18n="nav.downloadCv">{translate('fr', 'nav.downloadCv')}</span>
        </a>

        <button
          type="button"
          id="menu-toggle"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-white lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={translate('fr', 'nav.openMenu')}
          data-i18n-aria="nav.openMenu"
        >
          <span class="sr-only" data-i18n="nav.openMenu">{translate('fr', 'nav.openMenu')}</span>
          <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg id="menu-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="mt-2 hidden rounded-2xl border border-white/10 bg-[#0a1024]/95 p-4 backdrop-blur-xl lg:hidden"
    >
      <ul class="flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-11 items-center rounded-xl px-4 py-3 text-sm text-[var(--color-muted)] transition hover:bg-white/5 hover:text-white"
                data-mobile-link
                data-i18n={link.labelKey}
              >
                {translate('fr', link.labelKey)}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a href={siteConfig.cvPath} download={siteConfig.cvFileName} class="btn-primary w-full">
            <span data-i18n="nav.downloadCv">{translate('fr', 'nav.downloadCv')}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
    const labelKey = open ? 'nav.closeMenu' : 'nav.openMenu';
    toggle?.setAttribute('data-i18n-aria', labelKey);
    const sr = toggle?.querySelector('.sr-only');
    if (sr) {
      sr.setAttribute('data-i18n', labelKey);
      // Keep FR defaults; LanguageSwitcher will refresh if present
      sr.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    }
    toggle?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  };

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(open);
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  document.addEventListener('pointerdown', (e) => {
    if (!menu || menu.classList.contains('hidden')) return;
    const target = e.target as Node;
    if (menu.contains(target) || toggle?.contains(target)) return;
    setMenuOpen(false);
  });

  window.addEventListener(
    'resize',
    () => {
      if (window.matchMedia('(min-width: 1024px)').matches) setMenuOpen(false);
    },
    { passive: true },
  );

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add('[&_nav]:shadow-[0_10px_40px_rgba(0,0,0,0.35)]');
    } else {
      header.classList.remove('[&_nav]:shadow-[0_10px_40px_rgba(0,0,0,0.35)]');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const path = window.location.pathname.replace(/\/$/, '') || '/';
  const hash = window.location.hash;

  document.querySelectorAll('[data-nav-link]').forEach((el) => {
    const href = (el as HTMLAnchorElement).getAttribute('href') || '';
    const [linkPath, linkHash] = href.split('#');
    const normalizedPath = (linkPath || '/').replace(/\/$/, '') || '/';
    const isHome = path === '/';
    const matchesPath = normalizedPath === path;
    const matchesHash = linkHash
      ? hash === `#${linkHash}`
      : isHome && (href === '/' || href === '/#home') && !hash;

    if ((matchesPath && !linkHash) || (isHome && matchesHash) || (isHome && linkHash && hash === `#${linkHash}`)) {
      el.classList.add('text-white', 'bg-white/5');
      el.classList.remove('text-[var(--color-muted)]');
    }
  });
</script>
